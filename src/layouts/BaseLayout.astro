---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

const { title = 'damienrobson' } = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{title}</title>
  </head>
  <body>
    <div id='skip'>
      <a href='#content'>Skip to Content</a>
    </div>
    <Navbar />

    <main id='content'>
      <slot />
    </main>
  </body>
</html>
